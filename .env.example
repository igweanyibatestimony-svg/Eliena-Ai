# Server
PORT=3000
NODE_ENV=development

# SQLite database path. Relative paths are resolved from the project root.
ELIENA_DB_PATH=data/eliena.db

# AI provider (keys remain server-side; Phase 4 supports Gemini or OpenAI-compatible APIs)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=90000
